# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Credentials (NOT .env files - those are needed for deployment)
*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# Metro / Expo caches
frontend/.metro-cache/
.expo/
frontend/.expo/

# Expo / web build output (non deve finire nel repo)
frontend/dist*/

# Package lock (usiamo yarn)
frontend/package-lock.json
package-lock.json

# Credentials / secret non-env (chiavi, pem, ecc.)
credentials.json
*token.json*
*credentials.json*
*.key
.credentials

# IMPORTANTE: i file .env (backend/.env, frontend/.env) NON vanno ignorati:
# sono richiesti dal deploy Emergent per le variabili d'ambiente e il rewrite
# di EXPO_PUBLIC_BACKEND_URL. Ignoriamo solo gli override locali.
.env*.local
