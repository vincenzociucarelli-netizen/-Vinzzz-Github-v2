{
  "expo": {
    "name": "RegistraTEAM",
    "slug": "registrateam",
    "description": "RegistraTEAM — Software gestionale per società sportive: tesseramenti, presenze, compensi, GDPR, Riforma Sport. Per società di pallavolo, calcio e altre discipline.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*",
      "assets/fonts/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes to check athlete attendance",
        "NSPhotoLibraryUsageDescription": "Upload medical certificates for athletes"
      },
      "bundleIdentifier": "com.emergent.registrateamvol.sl9jk8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "package": "com.emergent.registrateamvol.sl9jk8"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow app to access camera for QR code scanning"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
